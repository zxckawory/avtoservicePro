<Window xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		xmlns:u="https://irihi.tech/ursa"
		xmlns:avalonia="using:Material.Icons.Avalonia"
		mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
		x:Class="avtoservicePro.MenuWindow"
		Title="Основное меню"
		Background="#F8F9FD">
	<u:OverlayDialogHost Name="DialogHost">
		<Grid ColumnDefinitions="*,*" RowDefinitions="Auto,*" Margin="15" Width="{Binding #DialogHost.Bounds.Width}" Height="{Binding #DialogHost.Bounds.Height}">

			<StackPanel Orientation="Horizontal" Margin="0,0,0,15">
				<Button Name="ExitButton" Click="ExitButton_Click" Height="45" Width="45" Padding="0" Margin="0,0,10,0" VerticalAlignment="Center">
					<avalonia:MaterialIcon Kind="ArrowBack" Height="26" Classes="ButtonImage"/>
				</Button>
				<TextBlock Text="Область просмотра" FontSize="28" FontWeight="Bold" Foreground="#2C3A4F" VerticalAlignment="Center" />
			</StackPanel>

			<StackPanel Orientation="Horizontal" Grid.Column="1" HorizontalAlignment="Right">
				<avalonia:MaterialIcon Kind="AccountCircleOutline" Margin="0,0,10,0" Width="40" Height="40"/>

				<StackPanel Margin="0,0,10,0" VerticalAlignment="Center">
					<TextBlock Name="FullNameTextBlock" FontSize="18" Foreground="#2C3A4F" FontWeight="Medium" Margin="0,0,10,5"/>
					<TextBlock Name="RoleTextBlock" FontSize="18" Foreground="#2C3A4F" FontWeight="Medium" Margin="0,0,10,0"/>
				</StackPanel>
			</StackPanel>

			<TabControl Grid.ColumnSpan="2" Grid.Row="1">
				<TabItem Header="Машины" Name="CarTabItem"/>

				<TabItem Header="Заказы" Name="OrderTabItem"/>

				<TabItem Header="Услуги" Name="ServiceTabItem"/>

				<TabItem Header="Пользователи" Name="UserTabItem"/>

				<TabItem Header="История заказов" Name="OrderHistoryTabItem"/>
			</TabControl>
		</Grid>
	</u:OverlayDialogHost>
</Window>
