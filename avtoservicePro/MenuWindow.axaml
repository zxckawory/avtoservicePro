<Window xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		xmlns:u="https://irihi.tech/ursa"
		xmlns:avalonia="using:Material.Icons.Avalonia"
		mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
		x:Class="avtoservicePro.MenuWindow"
		Title="Основное меню"
		Background="#F8F9FD">
	<u:OverlayDialogHost Name="DialogHost">
		<Grid ColumnDefinitions="*,*" RowDefinitions="Auto,*" Margin="15" Width="{Binding #DialogHost.Bounds.Width}" Height="{Binding #DialogHost.Bounds.Height}">

			<StackPanel Orientation="Horizontal">
				<Button Name="ExitButton" Click="ExitButton_Click" Height="45" Width="45" Padding="0" Margin="0,0,10,0" VerticalAlignment="Center">
					<avalonia:MaterialIcon Kind="ArrowBack" Height="26"/>
				</Button>
				<TextBlock Text="Область просмотра" FontSize="20" VerticalAlignment="Center" />
			</StackPanel>

			<StackPanel Grid.Column="1" HorizontalAlignment="Right" Margin="0,0,10,0" VerticalAlignment="Center">
				<TextBlock Name="FullNameTextBlock" Margin="0,0,10,5"/>
				<TextBlock Name="RoleTextBlock" Margin="0,0,10,0"/>
			</StackPanel>

			<TabControl Grid.ColumnSpan="2" Grid.Row="1">
				<TabItem Header="Машины" Name="CarTabItem"/>

				<TabItem Header="Заказы" Name="OrderTabItem"/>

				<TabItem Header="Услуги" Name="ServiceTabItem"/>

				<TabItem Header="Пользователи" Name="UserTabItem"/>
			</TabControl>
		</Grid>
	</u:OverlayDialogHost>
</Window>
